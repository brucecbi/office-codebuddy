<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">

  <Id>27ee7761-18ca-4fae-b482-4171d5afa6cd</Id>
  <Version>1.0.0.1</Version>
  <ProviderName>Draftspect</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Draftspect for Word" />
  <Description DefaultValue="Draftspect Developer Preview for Word — read, analyze and revise the active document through your selected agent provider. Office-only tools by default." />
  <IconUrl DefaultValue="http://127.0.0.1:47834/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="http://127.0.0.1:47834/icon-64.png" />
  <SupportUrl DefaultValue="http://127.0.0.1:47834/" />

  <AppDomains>
    <AppDomain>http://127.0.0.1:47834</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <!--
    Minimum Word API version. Required for changeTrackingMode, comments,
    insertComment, getComments — the floor of what every write-tool path
    needs. WordApi 1.6 enables stable local IDs and revision tools. Older
    hosts retain read coverage with explicit gaps; ID-dependent edits fail
    closed instead of writing through positional IDs.
  -->
  <Requirements>
    <Sets DefaultMinVersion="1.4">
      <Set Name="WordApi" MinVersion="1.4" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="http://127.0.0.1:47834/word/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.4">
        <bt:Set Name="WordApi" MinVersion="1.4" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="Draftspect.Taskpane.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Draftspect.Group">
                <Label resid="Draftspect.Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Draftspect.Icon32" />
                  <bt:Image size="32" resid="Draftspect.Icon32" />
                  <bt:Image size="80" resid="Draftspect.Icon64" />
                </Icon>
                <Control xsi:type="Button" id="Draftspect.ShowTaskpane">
                  <Label resid="Draftspect.Button.Label" />
                  <Supertip>
                    <Title resid="Draftspect.Button.Label" />
                    <Description resid="Draftspect.Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Draftspect.Icon32" />
                    <bt:Image size="32" resid="Draftspect.Icon32" />
                    <bt:Image size="80" resid="Draftspect.Icon64" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Draftspect.Pane</TaskpaneId>
                    <SourceLocation resid="Draftspect.Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Draftspect.Icon32" DefaultValue="http://127.0.0.1:47834/icon-32.png" />
        <bt:Image id="Draftspect.Icon64" DefaultValue="http://127.0.0.1:47834/icon-64.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Draftspect.Taskpane.Url" DefaultValue="http://127.0.0.1:47834/word/index.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Draftspect.Group.Label" DefaultValue="Draftspect" />
        <bt:String id="Draftspect.Button.Label" DefaultValue="显示 Draftspect 窗格" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Draftspect.Button.Tooltip" DefaultValue="打开 Draftspect 窗格以读取、分析和修订当前 Word 文档。" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
